# top-most EditorConfig file
root = true

# Don't use tabs for indentation.
[*]
indent_style = space

# Code files
[*.{cs,csx,vb,vbx}]
indent_size = 4
insert_final_newline = true
charset = utf-8
[tests/**.cs]
# Test names use Method_Scenario_Expected underscores
dotnet_diagnostic.CA1707.severity = none
